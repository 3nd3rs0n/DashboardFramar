generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  IN_ANALYSIS
  ACTION_DEFINED
  IN_EXECUTION
  PENDING_VERIFICATION
  CLOSED
  REOPENED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ProcedureStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  OBSOLETE
}

enum KpiFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model User {
  id                    String               @id @default(cuid())
  email                 String               @unique
  name                  String
  passwordHash          String
  role                  Role                 @default(ANALYST)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  auditLogs             AuditLog[]
  taskComments          TaskComment[]
  findingComments       FindingComment[]
  findingParticipations FindingParticipant[]
  procedureComments     ProcedureComment[]
}

model Department {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  processes       Process[]
  tasks           Task[]
  bonusFindings   BonusFinding[]
  bonusProcedures BonusProcedure[]
}

model Process {
  id              String           @id @default(cuid())
  name            String
  description     String?
  departmentId    String
  department      Department       @relation(fields: [departmentId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  procedures      Procedure[]
  findings        Finding[]
  kpis            Kpi[]
  bonusProcedures BonusProcedure[]

  @@unique([departmentId, name])
  @@index([departmentId])
}

model Procedure {
  id        String             @id @default(cuid())
  code      String?
  title     String
  content   String?
  version   String             @default("1.0")
  status    ProcedureStatus    @default(DRAFT)
  dueDate   DateTime?
  processId String
  process   Process            @relation(fields: [processId], references: [id])
  file      File?
  comments  ProcedureComment[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([processId])
}

model ProcedureComment {
  id          String    @id @default(cuid())
  body        String
  procedureId String
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([procedureId, createdAt])
}

model File {
  id          String     @id @default(cuid())
  filename    String
  mimetype    String
  size        Int
  data        Bytes
  procedureId String?    @unique
  procedure   Procedure? @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  findingId   String?    @unique
  finding     Finding?   @relation(fields: [findingId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
}

model Finding {
  id           String               @id @default(cuid())
  code         String?              @unique
  title        String
  type         String               @default("AUDIT")
  priority     Priority             @default(MEDIUM)
  status       FindingStatus        @default(OPEN)
  dueDate      DateTime?
  closedAt     DateTime?
  processId    String
  process      Process              @relation(fields: [processId], references: [id])
  file         File?
  comments     FindingComment[]
  participants FindingParticipant[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([processId])
  @@index([status])
}

model FindingParticipant {
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([findingId, userId])
  @@index([userId])
}

model FindingComment {
  id        String   @id @default(cuid())
  body      String
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([findingId, createdAt])
}

model Task {
  id            String        @id @default(cuid())
  title         String
  status        TaskStatus    @default(PENDING)
  priority      Priority      @default(MEDIUM)
  dueDate       DateTime?
  completedAt   DateTime?
  departmentId  String?
  department    Department?   @relation(fields: [departmentId], references: [id])
  responsibleId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  comments      TaskComment[]

  @@index([status])
}

model TaskComment {
  id        String   @id @default(cuid())
  body      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
}

model Kpi {
  id            String       @id @default(cuid())
  name          String
  description   String?
  formula       String?
  unit          String       @default("%")
  target        Float
  frequency     KpiFrequency @default(MONTHLY)
  processId     String
  process       Process      @relation(fields: [processId], references: [id])
  responsibleId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  values        KpiValue[]

  @@index([processId])
}

model KpiValue {
  id        String   @id @default(cuid())
  kpiId     String
  kpi       Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  value     Float
  period    String
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([kpiId, period])
}

model BonusKpiConfig {
  id          String              @id @default(cuid())
  key         String              @unique
  name        String
  description String
  maxPoints   Int
  thresholds  BonusKpiThreshold[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model BonusKpiThreshold {
  id        String         @id @default(cuid())
  configId  String
  config    BonusKpiConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  minCount  Int
  points    Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([configId, minCount])
  @@index([configId])
}

model BonusFinding {
  id             String                   @id @default(cuid())
  detectionDate  DateTime                 @default(now())
  departmentId   String
  department     Department               @relation(fields: [departmentId], references: [id])
  description    String
  cause          String?
  impact         String?
  responsibleId  String?
  proposedAction String?
  status         String                   @default("OPEN")
  closeDate      DateTime?
  evidence       String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  actions        BonusImprovementAction[]

  @@index([detectionDate])
  @@index([departmentId])
}

model BonusImprovementAction {
  id              String        @id @default(cuid())
  findingId       String?
  finding         BonusFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  action          String
  responsibleId   String?
  committedDate   DateTime?
  closeDate       DateTime?
  status          String        @default("OPEN")
  evidence        String?
  result          String?
  indicatorBefore String?
  indicatorAfter  String?
  resultValidated Boolean       @default(false)
  validatedById   String?
  validatedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([closeDate])
  @@index([status])
}

model BonusProcedure {
  id                 String     @id @default(cuid())
  name               String
  departmentId       String
  department         Department @relation(fields: [departmentId], references: [id])
  processId          String
  process            Process    @relation(fields: [processId], references: [id])
  identificationDate DateTime   @default(now())
  responsibleId      String?
  analysisStatus     String     @default("PENDING")
  draftingStatus     String     @default("PENDING")
  validationStatus   String     @default("PENDING")
  approvalDate       DateTime?
  diffusionDate      DateTime?
  version            String     @default("1.0")
  evidence           String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([identificationDate])
  @@index([departmentId])
  @@index([processId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  entity    String
  entityId  String
  action    String
  changes   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
